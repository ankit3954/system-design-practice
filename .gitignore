# Node modules (ignores the folder in every sub-directory)
node_modules/

# Environment variables (keeps passwords, ports, and API keys safe)
.env

# Log files (generated by npm if something crashes)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS generated files (keeps your repo clean from hidden system files)
.DS_Store
Thumbs.db